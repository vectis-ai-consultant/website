# Vercel/Neon Postgres — set by the Neon integration
DATABASE_URL=

# Signing + admin
TOKEN_SECRET=          # long random string; signs download links and hashes IPs
ADMIN_TOKEN=           # bearer token for GET /api/stats

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=            # e.g. Vectis AI <hello@meetvectis.com> — domain must be verified in Resend
NOTIFY_EMAIL=          # where discovery-call enquiries are sent

# Cal.com booking page behind the contact form's first step. Public by design —
# it is the same link anyone can visit; no API key is involved.
NEXT_PUBLIC_CAL_LINK=vectis-ai/30min

# Absolute origin, used to build the download link in the email
SITE_ORIGIN=https://meetvectis.com

# One per gated resource: the Vercel Blob URL of the file. Never sent to the browser.
RESOURCE_POSTER_AD_BATCH_URL=
